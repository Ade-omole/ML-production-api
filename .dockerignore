# .dockerignore - Files to exclude from Docker build context
# This makes Docker builds faster and images smaller

# Python cache files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
env/
ENV/
.venv

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Git
.git/
.gitignore

# Documentation and notes (not needed in container)
*.md
notes/
*.tex
*.pdf
*.aux
*.log
*.out
*.toc

# Test files
tests/
test_*.py
*_test.py

# Development files
.env.local
.env.development
*.pem
*.key

# OS files
.DS_Store
Thumbs.db

# Build artifacts
*.egg-info/
dist/
build/

# Jupyter notebooks (if any)
*.ipynb
.ipynb_checkpoints/

# Data files (if large, should be in separate volume)
*.csv
*.json
!model_metadata.json  # Keep this one if needed

# Logs
*.log
logs/
